<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cuy game core. .NET Standard 2.0 so it can be used by the eSheep-based app (.NET Framework 4.8).
    No WinForms and no Win32 (RULES.md).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Cuy.Core</RootNamespace>
    <AssemblyName>Cuy.Core</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same version as in packages.config to avoid a DLL conflict. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\data\actions.json" Link="actions.json" />
    <EmbeddedResource Include="..\..\assets\data\items.json" Link="items.json" />
  </ItemGroup>

</Project>
